<view class="page timeline-page">
  <view class="top-row">
    <view>
      <text class="eyebrow">记忆不是覆盖，而是沿着时间生长</text>
      <view class="page-title">主题时间线</view>
    </view>
    <button
      wx:if="{{selectedTopic}}"
      class="icon-button order-button"
      bindtap="toggleOrder"
    >{{ascending ? '旧→新' : '新→旧'}}</button>
  </view>
  <view class="page-subtitle">区分当前观点、历史观点、待审批冲突和未采用内容。</view>

  <view wx:if="{{topics.length}}" class="topic-picker card">
    <text class="picker-label">当前主题</text>
    <picker
      mode="selector"
      range="{{topicNames}}"
      value="{{selectedIndex}}"
      bindchange="onTopicChange"
    >
      <view class="picker-value">
        <text>{{selectedTopic.name}}</text>
        <text class="picker-arrow">⌔</text>
      </view>
    </picker>
    <text class="topic-count">共 {{selectedTopic.event_count || 0}} 个时间节点</text>
  </view>

  <view wx:if="{{error}}" class="error-card">
    <text>{{error}}</text>
    <button class="secondary retry-button" bindtap="retry">重试</button>
  </view>

  <view wx:if="{{loading}}" class="loading-card">正在加载时间线…</view>

  <view wx:elif="{{!topics.length && !error}}" class="empty">
    <text class="empty-title">还没有主题</text>
    <text>录下第一条备忘录后，这里会展示它的变化。</text>
  </view>

  <view wx:elif="{{selectedTopic && !events.length && !error}}" class="empty">
    <text class="empty-title">暂无时间节点</text>
    <text>这个主题目前没有可展示的记录。</text>
  </view>

  <view wx:else class="timeline-track">
    <view
      wx:for="{{events}}"
      wx:key="id"
      wx:for-item="item"
      class="timeline-row"
    >
      <view class="timeline-axis">
        <view class="timeline-dot status-{{item.status}}"></view>
        <view class="timeline-line"></view>
      </view>
      <view class="timeline-card card status-{{item.status}}">
        <view class="event-meta">
          <text class="event-time">{{item.occurredAtText}}</text>
          <text class="status-chip status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="event-title">{{item.title || item.one_line_summary}}</text>
        <text wx:if="{{item.title}}" class="event-summary">{{item.one_line_summary}}</text>
        <view class="event-change pre-wrap">{{item.one_line_change || '暂无变化说明'}}</view>
      </view>
    </view>
  </view>
</view>
