.timeline-page {
  padding-bottom: 48rpx;
}

.order-button {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.topic-picker {
  margin-bottom: 34rpx;
  padding: 26rpx 28rpx;
}

.picker-label,
.topic-count {
  display: block;
  color: #7b817d;
  font-size: 22rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 82rpx;
  margin: 12rpx 0;
  padding: 0 22rpx;
  border: 2rpx solid #d8ddd8;
  border-radius: 18rpx;
  background: #fff;
  color: #173e30;
  font-size: 30rpx;
  font-weight: 700;
}

.picker-arrow {
  color: #8b6e45;
  font-size: 34rpx;
}

.retry-button {
  width: 180rpx;
  min-height: 68rpx;
  margin: 24rpx 0 0;
}

.timeline-track {
  margin-top: 12rpx;
}

.timeline-row {
  display: flex;
  align-items: stretch;
}

.timeline-axis {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  flex-direction: column;
}

.timeline-dot {
  z-index: 1;
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  margin-top: 34rpx;
  border: 5rpx solid #f7f4ed;
  border-radius: 50%;
  background: #567264;
  box-shadow: 0 0 0 2rpx #567264;
}

.timeline-dot.status-current {
  background: #176344;
  box-shadow: 0 0 0 2rpx #176344;
}

.timeline-dot.status-pending_approval {
  background: #c58b18;
  box-shadow: 0 0 0 2rpx #c58b18;
}

.timeline-dot.status-rejected {
  background: #a24f42;
  box-shadow: 0 0 0 2rpx #a24f42;
}

.timeline-line {
  width: 2rpx;
  min-height: 54rpx;
  flex: 1;
  background: #d8d9d2;
}

.timeline-row:last-child .timeline-line {
  background: transparent;
}

.timeline-card {
  flex: 1;
  min-width: 0;
  margin: 0 0 22rpx 10rpx;
  padding: 28rpx;
  border-left: 8rpx solid #8b9992;
}

.timeline-card.status-current {
  border-left-color: #176344;
}

.timeline-card.status-pending_approval {
  border-left-color: #c58b18;
  background: #fffaf0;
}

.timeline-card.status-rejected {
  border-left-color: #a24f42;
  opacity: 0.82;
}

.event-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.event-time {
  color: #747d78;
  font-size: 22rpx;
}

.status-chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ecefeb;
  color: #56655e;
  font-size: 21rpx;
  font-weight: 700;
}

.status-chip.status-current {
  background: #e4f1e9;
  color: #176344;
}

.status-chip.status-pending_approval {
  background: #fff0bf;
  color: #74510e;
}

.status-chip.status-rejected {
  background: #f6e5e1;
  color: #903e32;
}

.event-title,
.event-summary,
.event-change {
  display: block;
}

.event-title {
  color: #18362a;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.event-summary {
  margin-top: 12rpx;
  color: #52645c;
  font-size: 26rpx;
  line-height: 1.6;
}

.event-change {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f1f3ef;
  color: #40564d;
  font-size: 25rpx;
  line-height: 1.65;
}
